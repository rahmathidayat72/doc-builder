# Satukit Production Environment Configuration
# File: /etc/satukit/satukit.env
# Permissions: chmod 600 /etc/satukit/satukit.env; chown satukit:satukit /etc/satukit/satukit.env

# Runtime Mode
ENVIRONMENT=production
IS_PRODUCTION=true
PROJECT_NAME="Satukit Production API"

# Public URL & Network Binding
PUBLIC_BASE_URL=https://your-domain.com
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=https://your-domain.com
TRUSTED_HOSTS=your-domain.com,127.0.0.1,localhost

# PostgreSQL Database (Native Ubuntu 24.04)
DATABASE_URL=postgresql+psycopg://satukit_user:GANTI_DENGAN_PASSWORD_DATABASE_KUAT@127.0.0.1:5432/satukit

# Secrets (Generate with: openssl rand -hex 32)
BOT_CHALLENGE_SECRET=GANTI_DENGAN_RANDOM_HEX_32_KARAKTER_UNTUK_BOT_CHALLENGE
SHORTENER_ADMIN_HMAC_SECRET=GANTI_DENGAN_RANDOM_HEX_32_KARAKTER_UNTUK_SHORTENER_HMAC

# Transactional Email (Brevo / Sendinblue REST API)
BREVO_API_KEY=xkeysib-GANTI_DENGAN_KUNCI_API_BREVO_ANDA
BREVO_SENDER_EMAIL=noreply@your-domain.com
BREVO_SENDER_NAME=Satukit

# Cloudflare R2 Encrypted Backup Storage
R2_ENDPOINT_URL=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=satukit-backups
R2_ACCESS_KEY_ID=GANTI_DENGAN_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=GANTI_DENGAN_R2_SECRET_ACCESS_KEY
BACKUP_ENCRYPTION_KEY_FILE=/etc/satukit/backup_aes256.key

# Storage & Quota Guards (Safe for 1 vCPU / 2.2 GiB RAM)
MAX_FILE_SIZE_MB=25
TEMP_DIR_GLOBAL_LIMIT_MB=500
TEMP_FILE_TTL_MINUTES=5
DISK_USAGE_WARNING_PERCENT=70.0
DISK_USAGE_CRITICAL_PERCENT=80.0
DISK_SWEEPER_INTERVAL_SECONDS=300
